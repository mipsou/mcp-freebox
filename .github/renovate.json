{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  "baseBranches": ["dev"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on Monday"],
  "labels": ["dependencies"],

  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "bump",

  "separateMajorMinor": true,
  "rangeStrategy": "pin",

  "packageRules": [
    {
      "description": "GitHub Actions — maintien automatique des SHA + commentaire version",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Go toolchain — mise a jour de la directive go X.Y.Z dans go.mod (resoud les CVEs stdlib automatiquement)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "groupName": "go-toolchain",
      "automerge": false
    },
    {
      "description": "Go modules — patch et minor groupes",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "groupName": "go-deps",
      "automerge": false
    },
    {
      "description": "Go modules — majeurs separes (breaking changes)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],

  "customManagers": [
    {
      "description": "govulncheck version epinglee dans ci.yml",
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.*\\.yml$"],
      "matchStrings": ["govulncheck@(?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    }
  ]
}
